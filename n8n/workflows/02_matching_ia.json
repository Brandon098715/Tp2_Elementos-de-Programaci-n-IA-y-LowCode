    {
      "parameters": {
        "jsCode": "// Cuenta cuántos resultados se procesaron en cada estado.\nconst items = $input.all().map((i) => i.json);\nconst contar = (estado) => items.filter((i) => i.estado_proceso === estado).length;\n\nreturn [{\n  json: {\n    procesados: items.length,\n    generadas: contar('generada'),\n    omitidos: contar('omitido'),\n    errores: contar('error'),\n    detalle_errores: items.filter((i) => i.estado_proceso === 'error'),\n    finalizado_en: new Date().toISOString(),\n  },\n}];\n"
      },
      "id": "dddf25b2-5ccd-4307-8c88-c524a576aec4",
      "name": "Resumen del procesamiento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
