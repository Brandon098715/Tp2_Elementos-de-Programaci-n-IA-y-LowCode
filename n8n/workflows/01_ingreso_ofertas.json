      "position": [
        -40,
        -260
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nueva-oferta",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "f4bdeb0f-403d-444f-b5f9-aed2066d018e",
      "name": "Webhook nueva oferta",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "21040432-9533-45d3-9417-207bb28f3840"
    },
    {
      "parameters": {
        "jsCode": "// Toma el JSON recibido por el webhook y lo deja listo para la API.\n// También arma la lista de errores para la condición siguiente.\nconst body = $input.first().json.body || {};\nconst texto = (v) => (typeof v === 'string' ? v.trim() : '');\n\nconst requisitos = Array.isArray(body.requisitos) ? body.requisitos : [];\n\nconst oferta = {\n  titulo: texto(body.titulo),\n  empresa: texto(body.empresa),\n  modalidad: texto(body.modalidad).toLowerCase(),\n  descripcion: texto(body.descripcion),\n  requisitos: requisitos\n    .map((r) => ({\n      skill: texto(r.skill),\n      nivel_minimo: Number(r.nivel_minimo ?? 1),\n      tipo: (texto(r.tipo) || 'obligatoria').toLowerCase(),\n    }))\n    .filter((r) => r.skill !== ''),   // descarta requisitos sin nombre\n};\n\nconst errores = [];\nif (!oferta.titulo) errores.push(\"Falta el campo 'titulo'.\");\nif (!oferta.empresa) errores.push(\"Falta el campo 'empresa'.\");\nif (!oferta.modalidad) errores.push(\"Falta el campo 'modalidad'.\");\nif (oferta.requisitos.length === 0) errores.push('La oferta debe tener al menos un requisito.');\n\nreturn [{ json: { oferta, errores, valido: errores.length === 0 } }];\n"
      },
