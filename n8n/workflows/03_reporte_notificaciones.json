    {
      "parameters": {
        "jsCode": "// Arma el asunto y el cuerpo HTML del email a partir de GET /reportes/resumen.\nconst r = $input.first().json;\nconst t = r.totales;\nconst pendientes = r.recomendaciones_pendientes;\n\nconst filasOfertas = r.score_promedio_por_oferta\n  .map((o) => `<tr><td>#${o.oferta_id} ${o.titulo}</td><td>${o.estado}</td>` +\n              `<td>${o.score_promedio ?? '—'}</td><td>${o.cantidad_resultados}</td></tr>`)\n  .join('');\n\nconst faltantes = r.competencias_mas_faltantes.slice(0, 5)\n  .map((f) => `<li>${f.skill}: ${f.cantidad}</li>`).join('');\n\nconst html = `\n<h2>Reporte diario — Plataforma de vinculación</h2>\n<p><b>Recomendaciones de IA pendientes de revisión: ${pendientes}</b></p>\n${pendientes > 0\n  ? '<p>Hay recomendaciones generadas por IA que necesitan revisión humana. ' +\n    'Revisalas en <a href=\"http://localhost:8501\">la interfaz</a> (sección Recomendaciones IA).</p>'\n  : '<p>No hay recomendaciones pendientes. ¡Todo al día!</p>'}\n<h3>Totales</h3>\n<ul>\n  <li>Estudiantes: ${t.estudiantes}</li>\n  <li>Ofertas abiertas: ${t.ofertas_abiertas} (cerradas: ${t.ofertas_cerradas})</li>\n  <li>Resultados de matching: ${t.resultados_matching}</li>\n  <li>Recomendaciones: aprobadas ${r.recomendaciones_por_estado.aprobada},\n      rechazadas ${r.recomendaciones_por_estado.rechazada}</li>\n</ul>\n<h3>Score promedio por oferta (calculado por reglas)</h3>\n<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\">\n  <tr><th>Oferta</th><th>Estado</th><th>Score promedio</th><th>Resultados</th></tr>\n  ${filasOfertas}\n</table>\n<h3>Competencias más faltantes</h3>\n<ul>${faltantes || '<li>Sin datos</li>'}</ul>\n`;\n\nreturn [{\n  json: {\n    pendientes,\n    asunto: pendientes > 0\n      ? `[TP2] ${pendientes} recomendación(es) de IA pendiente(s) de revisión`\n      : '[TP2] Reporte diario: sin recomendaciones pendientes',\n    html,\n  },\n}];\n"
      },
