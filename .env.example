# Copiar este archivo como .env y ajustar los valores.
# NUNCA subir el .env al repositorio.

# --- Base de datos ---
# Ruta del archivo SQLite (relativa a la raíz del proyecto o absoluta).
DB_PATH=data/vinculacion.db

# --- API ---
# URL que usa la interfaz Streamlit para llamar a la API.
# Sin Docker: http://localhost:8000   |   Con Docker: http://api:8000
API_URL=http://localhost:8000

# --- IA (Ollama corre en el host, no en Docker) ---
# Sin Docker: http://localhost:11434   |   Con Docker: http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Segundos máximos de espera por una respuesta del modelo.
OLLAMA_TIMEOUT=120

# --- Matching ---
# Score mínimo (0-100) a partir del cual se generan recomendaciones con IA.
UMBRAL_IA=50
